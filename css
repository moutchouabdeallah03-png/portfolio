/* ===== الصفحة كاملة ===== */

body {
    background-color: #f4f6f8;
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 30px;
    color: #222;
}


/* ===== العنوان الرئيسي ===== */

.title {
    color: white;
    background-color: #111827;
    font-size: 35px;
    text-align: center;
    font-weight: bold;

    padding: 20px;
    margin-bottom: 20px;

    border: 2px solid black;
    border-radius: 10px;
}


/* ===== الفقرات ===== */

p {
    font-size: 18px;
    line-height: 1.6;
}


/* ===== العناوين ===== */

h2 {
    color: #111827;
    margin-top: 30px;
}


/* ===== mark ===== */

mark {
    background-color: #00d9ff;
    padding: 5px 10px;
    border-radius: 5px;
}


/* ===== Skills ===== */

ul {
    background-color: white;
    padding: 20px 40px;

    border: 1px solid #ddd;
    border-radius: 10px;
}

li {
    margin: 10px 0;
    font-size: 17px;
}


/* ===== Projects ===== */

h3 {
    color: #333;
}


/* ===== CAR ZONE Link ===== */

a {
    display: inline-block;

    background-color: #111827;
    color: white;

    text-decoration: none;

    padding: 12px 20px;
    border-radius: 8px;

    font-weight: bold;
}


/* ===== عند مرور الماوس ===== */

a:hover {
    background-color: #00a8cc;
}
